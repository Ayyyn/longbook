{
  "hosting": {
    "public": "deploy/firebase-public",
    "ignore": ["**/.*"],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "textile-web",
          "region": "asia-south1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, s-maxage=60, must-revalidate"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
