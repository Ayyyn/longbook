DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/textileops

# The docker compose db publishes 5432. If a PostgreSQL service is already
# installed on the host it wins that port and you authenticate against the
# wrong server, so the test database runs on 5433 instead:
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/textileops

GEMINI_API_KEY=

# Set a bucket and media goes to GCS; leave it empty and it goes to UPLOAD_DIR.
# Cloud Run disk is ephemeral, so anything deployed needs the bucket.
GCS_BUCKET=
UPLOAD_DIR=var/uploads

BQ_DATASET=textile_ops
AUTO_COMMIT_FLOOR=0.85
ENV=dev
